# Copy to .env and adjust. All values are optional.

# Base URL printed in setup links.
MUSICUS_PUBLIC_URL=http://localhost:8080

# Port on the host, and which interface it listens on. Use 127.0.0.1 when
# the "https" profile (Caddy) is in front.
MUSICUS_PORT=8080
MUSICUS_BIND=0.0.0.0

# --- HTTPS profile: docker compose --profile https up -d ---------------------
# MUSICUS_DOMAIN=sheets.example.org
# MUSICUS_PUBLIC_URL=https://sheets.example.org
# MUSICUS_BIND=127.0.0.1
# MUSICUS_TRUST_PROXY=true

# none: browsers keep no copies of sheets; immutable: cache privately.
MUSICUS_CLIENT_CACHE=none
MUSICUS_RAM_CACHE_MB=128
MUSICUS_MAX_UPLOAD_MB=200
MUSICUS_SESSION_DAYS=60

# Only for trying it out over plain HTTP from another device on the LAN:
# browsers drop "Secure" cookies there, so logins would not stick.
MUSICUS_INSECURE_COOKIES=false
